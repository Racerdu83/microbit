from microbit import *
import radio
import utime

radio.on()

radio.config(channel = 7, power = 6, length = 32, group=42)

while True:
  Temperature = 0
  Temperature = temperature()
  utime.sleep(1)
  if temperature() <= 28:
    display.scroll(str(Temperature), delay=150, wait=True)
    display.show(Image.SAD)
    utime.sleep(1)
    radio.send(('{}' * 3).format("12. je suis malade ! J'ai ", temperature(), 'degrées'))
  else:
    if temperature() > 38:
      display.scroll(str(Temperature), delay=150, wait=True)
      display.show(Image.SAD)
      utime.sleep(1)
      radio.send(('{}' * 3).format("12. je suis malade ! J'ai ", temperature(), 'degrées'))
    else:
      display.scroll(str(Temperature), delay=150, wait=True)
      display.show(Image.HAPPY)
